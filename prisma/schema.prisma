// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Paste {
  id        String   @id @default(uuid())
  slug      String   @unique
  content   String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  views     Int      @default(0)
  maxViews  Int?
}
